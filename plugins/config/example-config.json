{
  "schema_version": "1.0",
  "scope": {
    "target_surveys": 3,
    "max_initial_candidates": 5,
    "minimum_successful_surveys": 0
  },
  "topic_execution": {
    "mode": "topic_coordinator",
    "target_papers": 4,
    "max_paper_candidates": 12,
    "target_technical_sources": 1,
    "max_technical_candidates": 5,
    "max_correction_rounds": 1,
    "accept_valid_artifacts_after_process_failure": true
  },
  "academic_worker": {"citation_chaining": "bounded"},
  "metadata_checker": {"content_checking": false},
  "technical_worker": {"tavily_required": false},
  "communication": {"file_queue_fallback": true},
  "paper_notes": {"template": ".claude/templates/paper-note.md"},
  "source_registry": {"enabled": true, "deduplicate": true},
  "prioritization": {
    "enabled": true,
    "ranking_unit": "research_line",
    "default_mode": "ordinal",
    "missing_value_policy": "unknown_not_zero",
    "incomplete_topic_assessment_is_fatal": false,
    "missing_paper_role_is_fatal": false,
    "require_final_prioritization_section": true,
    "surface_contradictory_evidence": true,
    "allow_qualitative_fallback": true
  },
  "finalization": {
    "enabled": true,
    "finalizer_agent": "slr-manager",
    "canonical_report": "SUMMARY.md",
    "max_prefinal_repair_rounds": 1,
    "allow_finalize_with_limitations": true,
    "finalizer_retries": 1,
    "allow_complete_with_warnings": true
  },
  "backends": {"default": "claude-code"}
}
